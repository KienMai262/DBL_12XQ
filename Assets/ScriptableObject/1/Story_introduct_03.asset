  m_Script: {fileID: 11500000, guid: 7ff7e1a551b864e4d94b235e1b05b001, type: 3}
  m_Name: Story_introduct_03
  m_EditorClassIdentifier: 
  type: 1
  description: 
  sentences:
    nameNPC: "Ng\xF4 Quy\u1EC1n"
    Lines:
    - "L\u1EC7nh v\u1EEBa d\u1EE9t, thuy\u1EC1n chi\u1EBFn \u0110\u1EA1i Vi\u1EC7t
      b\u1EA5t ng\u1EDD quay m\u0169i. L\u1EEDa \u0111\u01B0\u1EE3c ph\xF3ng theo
      gi\xF3, b\xE9n l\xEAn c\xE1nh bu\u1ED3m \u0111\u1ECBch. Gi\xF3 \u0111\xF4ng
      b\u1EAFc r\xEDt g\xE0o, s\xF3ng th\u1EE7y tri\u1EC1u cu\u1ED1n ph\u0103ng \u0111o\xE0n
      thuy\u1EC1n Nam H\xE1n v\xE0o b\xE3i c\u1ECDc. Ti\u1EBFng g\u1ED7 v\u1EE1,
      ti\u1EBFng kim kh\xED ch\u1EA1m nhau vang \u0111\u1ED9ng c\u1EA3 kh\xFAc s\xF4ng.
      L\u1EEDa h\xF2a c\xF9ng n\u01B0\u1EDBc, m\xE1u nhu\u1ED9m \u0111\u1ECF s\xF3ng
      B\u1EA1ch \u0110\u1EB1ng."
    - "Chi\u1EBFn th\u1EAFng B\u1EA1ch \u0110\u1EB1ng n\u0103m 938 \u0111\xE3 tr\u1EDF
      th\xE0nh m\u1ED1c son ch\xF3i l\u1ECDi, m\u1EDF ra k\u1EF7 nguy\xEAn \u0111\u1ED9c
      l\u1EADp t\u1EF1 ch\u1EE7 sau h\u01A1n m\u1ED9t ngh\xECn n\u0103m B\u1EAFc
      thu\u1ED9c. Nh\u01B0ng \xE1nh h\xE0o quang \u1EA5y ch\u01B0a k\u1ECBp s\xE1ng
      l\xE2u th\xEC khi Ng\xF4 Quy\u1EC1n b\u0103ng h\xE0 (944), tri\u1EC1u Ng\xF4
      nhanh ch\xF3ng suy y\u1EBFu. C\xE1c h\xE0o tr\u01B0\u1EDFng n\u1ED5i l\xEAn
      tranh gi\xE0nh, gieo m\u1EA7m cho lo\u1EA1n 12 s\u1EE9 qu\xE2n kh\u1EAFp Giao
      Ch\xE2u."
    images:
    - {fileID: 21300000, guid: 5011c9ca2dd36204dbba9f74f6ebe2c3, type: 3}
    - {fileID: 21300000, guid: 5011c9ca2dd36204dbba9f74f6ebe2c3, type: 3}
  choices:
  - choiceText: "M\u1ED9t ng\xE0y n\xE0o \u0111\xF3, ta c\u0169ng s\u1EBD nh\u01B0
      Ng\xF4 V\u01B0\u01A1ng, l\u01B0u danh thi\xEAn c\u1ED5."
    nextConversation: {fileID: 0}
