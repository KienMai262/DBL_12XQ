      L: 0
  - choiceText: "Th\u1EAFng tr\u1EADn th\xF4i ch\u01B0a \u0111\u1EE7 \u2013 quan
      tr\u1ECDng l\xE0 gi\u1EEF y\xEAn l\xF2ng d\xE2n \u0111\u1EC3 b\u1EC1n l\xE2u."
    nextConversation: {fileID: 0}
