  sentences:
    nameNPC: "\u0110\xE0m Th\u1ECB"
    Lines:
    - "Quy\u1EC1n l\u1EF1c nh\u01B0 n\u01B0\u1EDBc \u2013 n\xE2ng k\u1EBB bi\u1EBFt
