  sentences:
    nameNPC: "T\xF4i"
    Lines:
    - "(Gi\u1ECDng ch\u1EAFc n\u1ECBch) \u0110\u1EC3 thi\xEAn h\u1EA1 bi\u1EBFt \u0111\u1EBFn
