  m_Script: {fileID: 11500000, guid: 7ff7e1a551b864e4d94b235e1b05b001, type: 3}
  m_Name: Story_introduct_10
  m_EditorClassIdentifier: 
  type: 1
  description: 
  sentences:
    nameNPC: "T\xF4i"
    Lines:
    - "M\xF9a h\u1EA1 n\u0103m \u1EA5y, tr\u1EDDi Hoa L\u01B0 n\u1EAFng h\u1EA1n
      su\u1ED1t nhi\u1EC1u tu\u1EA7n. Ru\u1ED9ng \u0111\u1ED3ng n\u1EE9t n\u1EBB,
      d\xE2n l\xE0ng ng\u1EEDa m\u1EB7t c\u1EA7u m\u01B0a. R\u1ED3i b\u1EA5t ng\u1EDD,
      m\xE2y \u0111en \xF9n \xF9n k\xE9o \u0111\u1EBFn, gi\xF3 \u0111\u1ED5i chi\u1EC1u,
      s\u1EA5m s\xE9t d\u1ED9i kh\u1EAFp n\xFAi r\u1EEBng. Tr\u1EADn m\u01B0a \u0111\u1EA7u
      m\xF9a kh\xF4ng mang l\u1EA1i s\u1EF1 m\xE1t l\xE0nh, m\xE0 bi\u1EBFn th\xE0nh
      c\u01A1n cu\u1ED3ng n\u1ED9 c\u1EE7a thi\xEAn nhi\xEAn."
    - "N\u01B0\u1EDBc t\u1EEB th\u01B0\u1EE3ng ngu\u1ED3n \u0111\u1ED5 v\u1EC1, s\xF4ng
      Ho\xE0ng Long cu\u1ED3n cu\u1ED9n tr\xE0o d\xE2ng, nh\u1EA5n ch\xECm b\u1EDD
      b\xE3i. Nh\u1EEFng c\xE2y c\u1EA7u tre y\u1EBFu \u1EDBt b\u1EAFc qua s\xF4ng
      gi\u1EDD tr\u1EDF th\xE0nh tr\xF2 ch\u01A1i nguy hi\u1EC3m gi\u1EEFa c\u01A1n
      l\u0169 d\u1EEF."
    - "Trong bu\u1ED5i chi\u1EC1u gi\xF4ng t\u1ED1 \u1EA5y, \u0111\u1ECBnh m\u1EC7nh
      \u0111\u01B0a Ho\xE0n v\xE0o m\u1ED9t th\u1EED th\xE1ch \u0111\u1EA7u \u0111\u1EDDi
      \u2013 b\xE0i h\u1ECDc m\xE0 kh\xF4ng cu\u1ED1n s\xE1ch n\xE0o d\u1EA1y, ch\u1EC9
      c\xF3 th\u1EC3 h\u1ECDc b\u1EB1ng ch\xEDnh sinh m\u1EA1ng m\xECnh."
    images:
    - {fileID: 21300000, guid: ba370862297078040bbce71838be441a, type: 3}
    - {fileID: 21300000, guid: ba370862297078040bbce71838be441a, type: 3}
    - {fileID: 21300000, guid: ba370862297078040bbce71838be441a, type: 3}
  choices: []
  nextConversation: {fileID: 0}
  isCanonical: 1
  canonical: "Truy\u1EC1n thuy\u1EBFt k\u1EC3 r\u1EB1ng t\u1EEB thu\u1EDF nh\u1ECF,
    \u0110inh B\u1ED9 L\u0129nh \u0111\xE3 l\u1EA5y lau l\xE0m c\u1EDD, t\u1ED5 ch\u1EE9c
    tr\u1EBB con trong l\xE0ng t\u1EADp tr\u1EADn. H\xECnh \u1EA3nh \u201Cc\u1EDD
    lau t\u1EADp tr\u1EADn\u201D tr\u1EDF th\xE0nh bi\u1EC3u t\u01B0\u1EE3ng cho
    ch\xED kh\xED t\u1EEB t\u1EA5m b\xE9, \u0111\u1EB7t n\u1EC1n cho nghi\u1EC7p
    l\u1EDBn th\u1ED1ng nh\u1EA5t s\u01A1n h\xE0 sau n\xE0y."
