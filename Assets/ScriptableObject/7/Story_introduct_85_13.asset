  sentences:
    nameNPC: "T\u01B0\u1EDBng Tr\u1EA7n"
    Lines:
    - "Qu\xE2n ti\u1EBFp vi\u1EC7n t\u1EDBi! Bao v\xE2y ch\xFAng l\u1EA1i! \u0110\u1EEBng
